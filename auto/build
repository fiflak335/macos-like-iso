#!/bin/bash
set -euo pipefail

cd "$(dirname "$0")/.." 
BUILD_DIR="$(pwd)"

lb config noauto \
    --distribution bookworm \
    --archive-areas "main contrib non-free non-free-firmware" \
    --linux-flavours amd64 \
    --bootloaders "syslinux grub-efi" \
    --binary-images iso-hybrid \
    --memtest none \
    --firmware-binary true \
    --firmware-chroot true \
    --security true \
    --updates true \
    --backports true \
    --source false \
    --iso-application "macOS-like Live" \
    --iso-publisher "Custom Build" \
    --iso-volume "macOS-like $(date +%Y%m%d)" \
    --bootappend-live "boot=live components quiet splash username=macuser user-fullname='Mac User' hostname=maclike locales=en_US.UTF-8 keyboard-layouts=us timezone=UTC"

lb build

echo "Build complete. ISO location:"
ls -lh "$BUILD_DIR"/*.iso 2>/dev/null || ls -lh "$BUILD_DIR"/live-image-*.iso 2>/dev/null || find "$BUILD_DIR" -maxdepth 2 -name "*.iso" -type f
mkdir -p "$BUILD_DIR/output" 2>/dev/null || true
find "$BUILD_DIR" -maxdepth 1 -name "*.iso" -exec cp -v {} "$BUILD_DIR/output/" \; 2>/dev/null || true